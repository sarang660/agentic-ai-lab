GEMINI_API_KEY=

# Postgres with pgvector (Docker). Must match docker-compose.yml
DATABASE_URL=postgresql://rag_basics:rag_basics@localhost:5436/rag_basics
PGHOST=localhost
PGPORT=5436
PGUSER=rag_basics
PGPASSWORD=rag_basics
PGDATABASE=rag_basics
